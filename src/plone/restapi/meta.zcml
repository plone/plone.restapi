<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:meta="http://namespaces.zope.org/meta"
    i18n_domain="plone.restapi"
    >

  <meta:provides feature="plonerestapi-7" />

  <!-- plone.restapi handles Plate regions with "@type": "plate", not only the
       legacy "@type": "__somersault__". Add-ons that registered their own
       "plate" handlers can skip them with
       zcml:condition="not-have plonerestapi-plate-regions". -->
  <meta:provides feature="plonerestapi-plate-regions" />

</configure>
